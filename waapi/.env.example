# ===========================
# WaAPI Platform — Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun
# ===========================

# --- App ---
APP_NAME=WaAPI
DEBUG=true
SECRET_KEY=your-secret-key-here
ALLOWED_ORIGINS=["http://localhost:3000"]

# --- Database ---
DATABASE_URL=postgresql+asyncpg://waapi:waapi@postgres:5432/waapi
POSTGRES_USER=waapi
POSTGRES_PASSWORD=waapi
POSTGRES_DB=waapi

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- JWT ---
JWT_SECRET=your-jwt-secret-here
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Meta / WhatsApp ---
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_WEBHOOK_VERIFY_TOKEN=waapi_webhook_verify_2026

# --- AI ---
GEMINI_API_KEY=your-gemini-api-key

# --- ElevenLabs (opsiyonel) ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_ID=

# --- Encryption ---
ENCRYPTION_KEY=your-fernet-encryption-key

# --- Media Storage ---
MEDIA_STORAGE=local
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
